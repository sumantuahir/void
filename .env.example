# VOID Essentials Configuration

# Port for the Python backend server
PORT=8000

# Supabase PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
